        <mxCell id="e-ros-generic" edge="1" parent="1" source="ros" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.079;exitY=1;exitDx=0;exitDy=0;entryX=0.931;entryY=0;entryDx=0;entryDy=0;" target="generic" value="uses comms/ only">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-generic-iface" edge="1" parent="1" source="generic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.094;exitY=-0.004;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.883;entryY=-0.004;entryDx=0;entryDy=0;entryPerimeter=0;" target="iface" value="implements">
