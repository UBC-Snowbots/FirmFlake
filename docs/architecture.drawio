        <mxCell id="e-impl-iface" edge="1" parent="1" source="impl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.889;exitY=0;exitDx=0;exitDy=0;entryX=0.889;entryY=1;entryDx=0;entryDy=0;" target="iface" value="implements">
          <mxGeometry relative="1" as="geometry" />
